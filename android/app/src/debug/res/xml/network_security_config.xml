<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP is allowed everywhere, so the app can talk to
  a local dev API (http://10.0.2.2:8000). A network security config replaces
  android:usesCleartextTraffic, which is why this file exists.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
